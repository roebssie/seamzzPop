{
  "expo": {
    "name": "seamzzPop",
    "slug": "seamzzpop",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF9F4"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow seamzzPop to add garment inspiration from your photo library.",
          "cameraPermission": "Allow seamzzPop to photograph garment inspiration.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roebssie.seamzzpop"
    },
    "android": {
      "package": "com.roebssie.seamzzpop"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
